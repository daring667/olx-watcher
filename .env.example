# Создайте Telegram-бота через @BotFather и вставьте полученный токен.
TELEGRAM_BOT_TOKEN=replace_me

# Числовой ID личного чата. Узнать его можно командой: python get_chat_id.py
TELEGRAM_CHAT_ID=replace_me

# Ключи приложения OLX для уведомлений о сообщениях.
# Получить: https://developer.olx.kz/ -> подключить приложение.
# Callback URI при регистрации: https://daring667.github.io/olx-watcher/callback/
OLX_CLIENT_ID=replace_me
OLX_CLIENT_SECRET=replace_me

# Почтовые уведомления OLX (запасной путь, API нам закрыли).
# Для Gmail нужен ПАРОЛЬ ПРИЛОЖЕНИЯ, а не основной пароль:
# https://myaccount.google.com/apppasswords (требует включённой 2FA).
# Ящик открывается только на чтение: флаги писем не меняются.
MAIL_IMAP_USER=replace_me
MAIL_IMAP_PASSWORD=replace_me
# Необязательно: сервер, папка и отправители по умолчанию подходят для Gmail.
# MAIL_IMAP_HOST=imap.gmail.com
# MAIL_FOLDER=INBOX
# MAIL_SENDERS=olx.kz,olxgroup.com
