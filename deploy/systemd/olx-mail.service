[Unit]
Description=OLX message notifications via email
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{RUN_USER}}
WorkingDirectory={{PROJECT_DIR}}
# Новые файлы (база, WAL, бэкапы) — только для владельца: там токены и оплаты.
UMask=0077
ExecStart={{PROJECT_DIR}}/venv/bin/python olx_mail.py --interval 180
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=olx-mail

MemoryHigh=200M
MemoryMax=300M

[Install]
WantedBy=multi-user.target
