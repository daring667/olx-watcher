[Unit]
Description=OLX to Telegram Watcher
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{RUN_USER}}
WorkingDirectory={{PROJECT_DIR}}
ExecStart={{PROJECT_DIR}}/venv/bin/python olx_watcher.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=olx-watcher

# Потолок памяти: машина уже видела OOM-kill, поэтому лимит есть, но с запасом.
# Замер на droid: разбор страницы выдачи (3 МБ HTML, 41 карточка) плюс восемь
# страниц объявлений дают пик 86 МБ. 512/768M — примерно шестикратный запас.
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
