[Unit]
Description=OLX Watcher database backup
After=network.target

[Service]
Type=oneshot
User={{RUN_USER}}
WorkingDirectory={{PROJECT_DIR}}
# Новые файлы (база, WAL, бэкапы) — только для владельца: там токены и оплаты.
UMask=0077
ExecStart={{PROJECT_DIR}}/venv/bin/python deploy/backup.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=olx-backup
