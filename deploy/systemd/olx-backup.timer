[Unit]
Description=Hourly OLX Watcher database backup

[Timer]
# Раз в час: копия уходит на Google Диск (hourly/ — 48 ч, daily/ — 30 дн.).
OnCalendar=hourly
# Машина может быть выключена в назначенный час — тогда копия снимается сразу
# после включения, а не пропускается до следующих суток.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
